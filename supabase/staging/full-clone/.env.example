# Gitignored copy: supabase/staging/full-clone/.env.local
# Never commit production or service_role values.

# --- Production backup (shell session only; do NOT put in .env.local staging file) ---
# Prefer: ./supabase/staging/scripts/full-clone/configure-production-backup-url.sh
TRADETRAXS_PRODUCTION_BACKUP_MODE=session_pooler
TRADETRAXS_PRODUCTION_DATABASE_URL=postgresql://postgres.fobudrkniacatvilbofw:PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: Supabase Vault / pgsodium key copy (only if you use Vault)
# SUPABASE_ACCESS_TOKEN=

# --- Staging restore (may also use supabase/staging/.env.local) ---
TRADETRAXS_ENV=staging
TRADETRAXS_STAGING_PROJECT_REF=hxlcvffvyadlxcsqxxoy
TRADETRAXS_STAGING_DATABASE_URL=postgresql://postgres.hxlcvffvyadlxcsqxxoy:PASSWORD@db.hxlcvffvyadlxcsqxxoy.supabase.co:5432/postgres

# Required for destructive restore:
# TRADETRAXS_FULL_CLONE_CONFIRM=yes

# --- Storage object copy (after DB restore) ---
