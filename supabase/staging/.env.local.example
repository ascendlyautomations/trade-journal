# Copy to supabase/staging/.env.local (gitignored). Staging bootstrap + load tests only.
# Do NOT put production database URLs or service_role keys here.

TRADETRAXS_ENV=staging
LOADTEST_ENV=staging

# Must match supabase/staging/scripts/lib/project-guard.sh allowlist.
TRADETRAXS_STAGING_PROJECT_REF=hxlcvffvyadlxcsqxxoy

# Direct Postgres (preferred for restore/verify): db.hxlcvffvyadlxcsqxxoy.supabase.co
# Session pooler also works if live host resolves to the same project ref.
TRADETRAXS_STAGING_DATABASE_URL=postgresql://postgres.hxlcvffvyadlxcsqxxoy:YOUR_DB_PASSWORD@db.hxlcvffvyadlxcsqxxoy.supabase.co:5432/postgres

# Optional — used by loadtest/.env (can duplicate there instead):
# LOADTEST_SUPABASE_URL=https://hxlcvffvyadlxcsqxxoy.supabase.co
# LOADTEST_SUPABASE_ANON_KEY=your_staging_anon_key

# Production schema export ONLY — set in shell for export-production-schema.sh, not in .env.local:
# TRADETRAXS_PRODUCTION_DATABASE_URL=postgresql://…read-only…@db.fobudrkniacatvilbofw.supabase.co:5432/postgres
