# Copy to loadtest/.env.production-perf (gitignored). chmod 600
# Production read perf ONLY — never commit filled file.

LOADTEST_ENV=production
TRADETRAXS_PROD_PERF_CONFIRM=yes
TRADETRAXS_PRODUCTION_PROJECT_REF=fobudrkniacatvilbofw

# Workload (see loadtest/WORKLOAD_TAXONOMY.md):
#   supabase_direct   — worst-case PostgREST / DB stress (default)
#   client_realistic  — app-shaped mix + VU jitter (still PostgREST; no browser cache)
LOADTEST_WORKLOAD_KIND=supabase_direct
# Optional: LOADTEST_FEED_SCOPE=following|global  LOADTEST_VU_START_JITTER_SEC=12

# --- Smoke (run first): 1 VU × 30s ---
LOADTEST_PROD_PERF_MODE=smoke
LOADTEST_MAX_VUS=1

# --- Full (only after successful smoke): uncomment and set TRADETRAXS_PROD_PERF_FULL=yes ---
# LOADTEST_PROD_PERF_MODE=full
# LOADTEST_MAX_VUS=5
# TRADETRAXS_PROD_PERF_FULL=yes

# --- Ten (10 VU × 60s, after successful smoke): TRADETRAXS_PROD_PERF_TEN=yes ---
# LOADTEST_PROD_PERF_MODE=ten
# LOADTEST_MAX_VUS=10
# TRADETRAXS_PROD_PERF_TEN=yes

# --- Twentyfive (25 VU × 60s, after smoke + ten): TRADETRAXS_PROD_PERF_TWENTYFIVE=yes ---
# LOADTEST_PROD_PERF_MODE=twentyfive
# LOADTEST_MAX_VUS=25
# TRADETRAXS_PROD_PERF_TWENTYFIVE=yes
# LOADTEST_WORKLOAD_KIND=client_realistic
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=12
# LOADTEST_USERS_JSON — five dedicated users required (see loadtest/docs/PROD_PERF_FIVE_ACCOUNT_SETUP.md)

# --- Fifty (50 VU × 60s, after smoke + ten): TRADETRAXS_PROD_PERF_FIFTY=yes ---
# LOADTEST_PROD_PERF_MODE=fifty
# LOADTEST_MAX_VUS=50
# TRADETRAXS_PROD_PERF_FIFTY=yes
# LOADTEST_WORKLOAD_KIND=client_realistic
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=12

# --- Seventyfive (75 VU × 60s, bracket after fifty): TRADETRAXS_PROD_PERF_SEVENTYFIVE=yes ---
# LOADTEST_PROD_PERF_MODE=seventyfive
# LOADTEST_MAX_VUS=75
# TRADETRAXS_PROD_PERF_SEVENTYFIVE=yes
# LOADTEST_WORKLOAD_KIND=client_realistic
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=12
# LOADTEST_USERS_JSON — >= 30 dedicated users

# --- Hundred (100 VU × 60s, after seventyfive): TRADETRAXS_PROD_PERF_HUNDRED=yes ---
# LOADTEST_PROD_PERF_MODE=hundred
# LOADTEST_MAX_VUS=100
# TRADETRAXS_PROD_PERF_HUNDRED=yes
# LOADTEST_WORKLOAD_KIND=client_realistic
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=12
# LOADTEST_USERS_JSON — >= 30 dedicated users (see provision-prod-perf-accounts.py)

# --- Onefifty (150 VU × 60s, after hundred): TRADETRAXS_PROD_PERF_ONEFIFTY=yes ---
# LOADTEST_PROD_PERF_MODE=onefifty
# LOADTEST_MAX_VUS=150
# TRADETRAXS_PROD_PERF_ONEFIFTY=yes
# LOADTEST_WORKLOAD_KIND=client_realistic
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=12
# LOADTEST_USERS_JSON — exactly 50 dedicated users (see loadtest/docs/PROD_PERF_ONEFIFTY_FIFTY_USERS.md)

# --- Realistic150 (150 VU iOS mix, ramp + 10m sustain): TRADETRAXS_PROD_PERF_REALISTIC150=yes ---
# LOADTEST_PROD_PERF_MODE=realistic150
# LOADTEST_MAX_VUS=150
# TRADETRAXS_PROD_PERF_REALISTIC150=yes
# LOADTEST_WORKLOAD_KIND=realistic150_ios
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=45
# LOADTEST_USERS_JSON — exactly 50 dedicated users (150 concurrent sessions, not 150 accounts)
# See loadtest/docs/PROD_PERF_REALISTIC150.md

# --- Realistic300 (300 VU iOS mix, same workload as realistic150): TRADETRAXS_PROD_PERF_REALISTIC300=yes ---
# LOADTEST_PROD_PERF_MODE=realistic300
# LOADTEST_MAX_VUS=300
# TRADETRAXS_PROD_PERF_REALISTIC300=yes
# LOADTEST_WORKLOAD_KIND=realistic150_ios
# LOADTEST_FEED_SCOPE=following
# LOADTEST_VU_START_JITTER_SEC=45
# LOADTEST_USERS_JSON — exactly 50 dedicated users (300 concurrent sessions share 50 accounts)
# See loadtest/docs/PROD_PERF_REALISTIC300.md

# --- Realistic300_full (reads + DM/room + Realtime): separate script prod-realistic300-full.js ---
# TRADETRAXS_PROD_PERF_REALISTIC300_FULL=yes
# LOADTEST_MAX_VUS=300

# --- Realistic600_full (600 VU, 100 accounts, separate fixture): prod-realistic600-full.js ---
# TRADETRAXS_PROD_PERF_REALISTIC600_FULL=yes
# LOADTEST_MAX_VUS=600
# LOADTEST_FULL_MAX_DM_SENDS_TOTAL=400
# LOADTEST_FULL_MAX_ROOM_SENDS_TOTAL=400
# LOADTEST_FULL_MESSAGE_TAG=[loadtest:realistic600_full]
# LOADTEST_REALISTIC600_USERS_JSON='[ ... anchor + perfload02..100 ... ]'
# TRADETRAXS_PERF_AUTH_SIGNUP_SPACING_SEC=3
# LOADTEST_REALISTIC600_FULL_FIXTURE_FILE=loadtest/fixtures/realistic600-full-isolation.json
# LOADTEST_K6_SETUP_AUTH_SPACING_SEC=3

# --- Realistic1000_full (1000 VU, same 100 accounts + fixture as 600): prod-realistic1000-full.js ---
# TRADETRAXS_PROD_PERF_REALISTIC1000_FULL=yes
# (unset TRADETRAXS_PROD_PERF_REALISTIC600_FULL)
# LOADTEST_MAX_VUS=1000
# LOADTEST_FULL_MAX_DM_SENDS_TOTAL=700
# LOADTEST_FULL_MAX_ROOM_SENDS_TOTAL=700
# LOADTEST_FULL_MESSAGE_TAG=[loadtest:realistic1000_full]
# Same LOADTEST_REALISTIC600_USERS_JSON and LOADTEST_REALISTIC600_FULL_FIXTURE_FILE as 600_full
# See loadtest/docs/PROD_PERF_REALISTIC1000_FULL.md
# LOADTEST_FULL_REALTIME_DELIVERY_TIMEOUT_MS=8000
# TRADETRAXS_PROD_PERF_FIXTURE_PROVISION=yes   # required only for provision-realistic300-full-fixture.py (not dry-run)
# LOADTEST_MAX_VUS=300
# LOADTEST_FULL_SKIP_PUSH=yes
# LOADTEST_FULL_MAX_DM_SENDS_TOTAL=200
# LOADTEST_FULL_MAX_ROOM_SENDS_TOTAL=200
# LOADTEST_FULL_MAX_DM_SENDS_PER_VU=3
# LOADTEST_FULL_MAX_ROOM_SENDS_PER_VU=2
# LOADTEST_REALISTIC300_FULL_FIXTURE_JSON='{"schemaVersion":1,...}'
# See loadtest/docs/PROD_PERF_REALISTIC300_FULL.md

