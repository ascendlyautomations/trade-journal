# Copy to loadtest/.env and fill with STAGING values only.
# loadtest/.env is gitignored. Do not put production keys or real user passwords here.

LOADTEST_ENV=staging

# Staging Supabase project URL. Must not be the production project.
LOADTEST_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co

# Staging anon key only. Service-role keys are refused.
LOADTEST_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# Staging web origin that serves /api/leaderboard/trades. No trailing path.
LOADTEST_WEB_URL=https://staging.example.com

# Dedicated staging users. JSON array. Do not use production accounts.
LOADTEST_USERS_JSON=[{"email":"loadtest-user-001@example.com","password":"replace-me"}]

# First run stays at 10. Later runs may use 1, 25, 50, or 100.
LOADTEST_MAX_VUS=10
