{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel-npm.sh ci",
  "buildCommand": "bash scripts/vercel-npm.sh run build",
  "crons": [
    {
      "path": "/api/cron/apple-sign-in-revoke",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/expired-stories",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/weekly-trading-reports",
      "schedule": "0 17 * * 6"
    }
  ]
}
