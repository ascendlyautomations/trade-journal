# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Desktop.ini
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!loadtest/.env.example
!loadtest/.env.production-perf.example
loadtest/.env.production-perf
loadtest/fixtures/realistic300-full-isolation.json
loadtest/fixtures/realistic600-full-isolation.json
loadtest/fixtures/realistic300-full-isolation.uuid-map.json
loadtest/out/
loadtest/.recovery/
!supabase/staging/.env.local.example
!supabase/staging/full-clone/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Xcode user state (local IDE metadata)
*.xcuserstate

# Network captures (may contain auth tokens or session data)
*.har

# iOS client secrets (public anon key / URLs — still do not commit)
native-ios/TradeTraxs/TradeTraxs/Config/Secrets.plist
native-ios/TradeTraxs/TradeTraxs/Config/Secrets.production.plist
.derivedData*/
DerivedData/
