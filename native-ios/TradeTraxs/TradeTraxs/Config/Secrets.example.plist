<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		EXAMPLE ONLY — never commit a real Secrets.plist.
		Copy to Secrets.plist locally, or to Secrets.production.plist for Release-only archives.

		Release archives resolve configuration in this order (Run Script build phase):
		  1. Config/Secrets.plist
		  2. Config/Secrets.production.plist
		  3. SUPABASE_URL + SUPABASE_ANON_KEY (+ optional API_BASE_URL) build env vars

		All values are public client configuration (anon key is publishable).

		API_BASE_URL is optional. When empty/unset:
		  - Debug → https://www.tradetraxs.com
		  - Release/Production → https://www.tradetraxs.com
		Set explicitly only to override (e.g. http://localhost:3000).
	-->
	<key>SUPABASE_URL</key>
	<string></string>
	<key>SUPABASE_ANON_KEY</key>
	<string></string>
	<!-- Optional BFF origin override for /api/* (Trade AI, push register, reports, …). -->
	<key>API_BASE_URL</key>
	<string></string>
</dict>
</plist>
