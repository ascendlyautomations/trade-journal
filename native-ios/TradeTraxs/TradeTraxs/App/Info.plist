<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Opt out of iOS 26 floating Liquid Glass chrome so tab/navigation bar
	  backgrounds remain edge-anchored (extend through status bar + home indicator)
	  while interactive controls stay inside the system safe areas.

	  This is OS-design compatibility — not a device-specific hack. Without it,
	  TabView/NavigationStack float above the home indicator and leave an uncovered
	  strip at the physical bottom (and similarly under-extend at the top).
	-->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tradetraxs.TradeTraxs.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tradetraxs</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>TradeTraxs needs the camera to record trading clips.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TradeTraxs needs the microphone to record voice messages and trading clips.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
